#!/usr/bin/env python3
#
# This hook is invoked by snapd whenever a write is made through the
# landscape-client/admin confdb view. It reads the newly written values back
# out and persists them to landscape-client.conf.

import json
import os
import subprocess
import sys

from landscape.client.deployment import Configuration
from landscape.client.snap_config import CONFIG_ENTRIES


def _snapctl(*args):
    result = subprocess.run(["snapctl", *args], capture_output=True, text=True)
    if result.returncode != 0:
        print(result.stderr.strip(), file=sys.stderr)
        sys.exit(1)

    return result.stdout.strip()


config = Configuration()
config.load([])

raw = _snapctl("get", "--view", ":landscape-client-admin", "-d")
values = json.loads(raw) if raw else {}

for confdb_key, landscape_key, mapping_fn in CONFIG_ENTRIES:
    value = values.get(confdb_key)
    if not value:
        # empty, value has not changed
        continue

    if mapping_fn:
        value = mapping_fn(value)

    setattr(config, landscape_key, value)

config.write()

# May contain sensitive values (e.g. registration_key); keep it locked down.
# config.write() doesn't reset permissions on an existing file, but this is
# defense-in-depth for cases where the underlying file didn't already exist.
os.chmod(config.get_config_filename(), 0o600)
