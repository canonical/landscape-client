#!/usr/bin/env python3
#
# This hook reads snap options set via `snap set`, writes them to
# landscape-client.conf, and then unsets them.
# The landscape-client.conf file is the single source of truth,
# snap options are transient inputs only.

import os
import subprocess
import sys

from landscape.client.deployment import Configuration
from landscape.client.snap_config import CONFIG_ENTRIES, update_ssl_ca_cert


def _snapctl(*args):
    result = subprocess.run(["snapctl", *args], capture_output=True, text=True)
    if result.returncode != 0:
        print(result.stderr.strip(), file=sys.stderr)
        sys.exit(1)

    return result.stdout.strip()


config = Configuration()
config.load([])

# Deprecated keys kept for backward compatibility.
# New keys take precedence.
legacy_config_entries = [
    ("landscape-url", "url", lambda url: f"{url}/message-system"),
    ("landscape-ping-url", "ping_url", lambda url: f"{url}/ping"),
]

# Not in CONFIG_ENTRIES because the confdb schema does not define it.
snap_only_config_entries = [
    ("ssl-ca", "ssl_ca", update_ssl_ca_cert),
]

changed = set()
for snapctl_key, landscape_key, mapping_fn in [
    *legacy_config_entries,
    *CONFIG_ENTRIES,
    *snap_only_config_entries,
]:
    value = _snapctl("get", snapctl_key)
    if not value:
        # empty, value has not changed
        continue

    if mapping_fn:
        value = mapping_fn(value)

    setattr(config, landscape_key, value)
    changed.add(snapctl_key)

config.write()

# May contain sensitive values (e.g. registration_key); keep it locked down.
# config.write() doesn't reset permissions on an existing file, but this is
# defense-in-depth for cases where the underlying file didn't already exist.
os.chmod(config.get_config_filename(), 0o600)

# Unset changed keys so that on the next run we know what has changed.
if changed:
    _snapctl("unset", *changed)
